# Stage 1: Build Phase
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Pass OpenSSL legacy flag for Node 18 compatibility
ENV NODE_OPTIONS=--openssl-legacy-provider

RUN npm run build

# Stage 2: Production Phase with Nginx
FROM nginx:1.25-alpine

COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]